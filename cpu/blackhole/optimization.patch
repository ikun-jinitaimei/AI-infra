+#ifndef WAVE_COLLECTIVE_H
+#define WAVE_COLLECTIVE_H
+#include <cstring>
+#include <vector>
+#include <cstdint>
+struct WaveCollective {
+ MPI_Win win=MPI_WIN_NULL;
+ int rank=0,size=0,capacity=0;
+ unsigned long long epoch=0,round=0;
+ std::vector<char*> slot;
+ static unsigned long long load(char *p,int k) { return __atomic_load_n(reinterpret_cast<unsigned long long*>(p)+k,__ATOMIC_ACQUIRE); }
+ static void store(char *p,int k,unsigned long long v) { __atomic_store_n(reinterpret_cast<unsigned long long*>(p)+k,v,__ATOMIC_RELEASE); }
+ static void wait(char *p,int k,unsigned long long v) { while(load(p,k)<v) {
+#ifdef __aarch64__
+ asm volatile("yield" ::: "memory");
+#endif
+ } }
+ void init(int n) {
+  if(win!=MPI_WIN_NULL)return;
+  capacity=n;MPI_Comm local;MPI_Comm_split_type(MPI_COMM_WORLD,MPI_COMM_TYPE_SHARED,0,MPI_INFO_NULL,&local);
+  MPI_Comm_rank(local,&rank);MPI_Comm_size(local,&size);
+  MPI_Info info;MPI_Info_create(&info);MPI_Info_set(info,"alloc_shared_noncontig","true");
+  char *base;MPI_Win_allocate_shared(256+n*sizeof(double),1,info,local,&base,&win);MPI_Info_free(&info);
+  std::memset(base,0,256+n*sizeof(double));slot.resize(size);
+  for(int r=0;r<size;++r){MPI_Aint bytes;int unit;MPI_Win_shared_query(win,r,&bytes,&unit,&slot[r]);}
+  MPI_Win_lock_all(0,win);MPI_Win_sync(win);MPI_Barrier(local);MPI_Win_sync(win);MPI_Comm_free(&local);
+ }
+ void barrier() {
+  ++epoch;
+  for(int c=2*rank+1;c<=2*rank+2&&c<size;++c)wait(slot[c],0,epoch);
+  store(slot[rank],0,epoch);
+  if(rank==0)store(slot[0],8,epoch);else wait(slot[0],8,epoch);
+ }
+ void sum(const double *input,double *output,int n) {
+  ++round;double *mine=reinterpret_cast<double*>(slot[rank]+256);
+  std::memcpy(mine,input,n*sizeof(double));
+  for(int c=2*rank+1;c<=2*rank+2&&c<size;++c){
+   wait(slot[c],16,round);const double *child=reinterpret_cast<double*>(slot[c]+256);
+   for(int j=0;j<n;++j)mine[j]+=child[j];
+  }
+  store(slot[rank],16,round);
+  if(rank==0)store(slot[0],24,round);else wait(slot[0],24,round);
+  std::memcpy(output,slot[0]+256,n*sizeof(double));
+ }
+};
+static WaveCollective wave_collective;
+#endif

+#include "../ai_src/sparsemax_bellman.hpp"
+#include "../ai_src/simple_dp_sparsemax.hpp"
+#include <random>
+#include <cmath>
+#include <iostream>
+int main(){
+  std::mt19937_64 rng(8142);
+  for(int trial=0;trial<50000;++trial){
+    int n=1+rng()%80;
+    std::vector<sparsemax_bellman::Candidate> a;
+    std::vector<simple_dp_sparsemax::Candidate> b;
+    double base=int(rng()%20001)-10000;
+    for(int k=0;k<n;++k){
+      double z=(int(rng()%4097)-2048)/1024.0;
+      if(trial%3==0)z=std::round(z*2)/2;
+      double score=base+z*sparsemax_bellman::kTauPoints;
+      a.emplace_back(sparsemax_bellman::Record{.2,30,.4,score});
+      b.emplace_back(simple_dp_sparsemax::PointsRecord{.2,base+z,{{1,2,3,4,5}}});
+    }
+    auto p=sparsemax_bellman::weights(a);auto q=sparsemax_projection::project(a,sparsemax_bellman::kTauPoints);
+    auto r=simple_dp_sparsemax::weights(b);auto s=sparsemax_projection::project(b,1.0);
+    for(int k=0;k<n;++k)if(std::abs(p[k]-q.weight(a[k].record.points_exp))>1e-13||std::abs(r[k]-s.weight(b[k].record.points_exp))>1e-13)return 1;
+  }
+  std::cout<<"50000 projection differential cases passed\n";
+}

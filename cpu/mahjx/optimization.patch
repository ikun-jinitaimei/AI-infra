--- a/src/ai_src/sparsemax_projection.hpp
+++ b/src/ai_src/sparsemax_projection.hpp
@@ -0,0 +1,33 @@
+#pragma once
+#include <algorithm>
+#include <boost/container/small_vector.hpp>
+
+namespace sparsemax_projection {
+struct Projection {
+  double maximum, theta, tau;
+  double weight(double score) const {
+    return std::max(0.0,(score-maximum)/tau-theta);
+  }
+};
+template<class C> inline Projection project(const C &c,double tau) {
+  if(c.empty()) return {0,0,tau};
+  double maximum=c[0].record.points_exp;
+  for(std::size_t i=1;i<c.size();++i) maximum=std::max(maximum,c[i].record.points_exp);
+  boost::container::small_vector<double,8> active;
+  // The simplex threshold is >= -1 after subtracting the maximum.
+  // Scores at or below -1 therefore have exactly zero projected weight.
+  for(const auto &v:c) {
+    double z=(v.record.points_exp-maximum)/tau;
+    if(z<=-1.0)continue;
+    active.push_back(z);
+    for(std::size_t j=active.size()-1;j&&active[j]>active[j-1];--j)std::swap(active[j],active[j-1]);
+  }
+  double prefix=0,theta=0;
+  for(std::size_t k=0;k<active.size();++k) {
+    prefix+=active[k];double t=(prefix-1.0)/double(k+1);
+    if(active[k]>t)theta=t;
+    else break;
+  }
+  return {maximum,theta,tau};
+}
+}
